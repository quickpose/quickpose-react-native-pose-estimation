require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'QuickPoseExample' do
  # QuickPose SDK pods (hosted on GitHub, not CocoaPods trunk).
  # Single source of truth for the pinned iOS SDK tag — bumped by scripts/release.sh.
  quickpose_ios_tag = 'v1.7.0'
  pod 'QuickPoseCore', :git => 'https://github.com/quickpose/quickpose-ios-sdk.git', :tag => quickpose_ios_tag
  pod 'QuickPoseCamera', :git => 'https://github.com/quickpose/quickpose-ios-sdk.git', :tag => quickpose_ios_tag
  pod 'QuickPoseSwiftUI', :git => 'https://github.com/quickpose/quickpose-ios-sdk.git', :tag => quickpose_ios_tag

  # QuickPose React Native plugin
  pod 'quickpose-react-native', :path => '../..'

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'QuickPoseExampleTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
    # fmt 11's consteval format-string checking miscompiles under Xcode 26.4's clang
    # (constexpr pointer arithmetic across string literals), and fmt hardcodes its
    # consteval detection with no override macro. Compiling the fmt target as C++17
    # removes __cpp_consteval so fmt disables the feature itself.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'fmt'
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
  end
end
